{
  "title": "Sophie",
  "description": "Sophie production overview. OpenTelemetry labeled metrics filtered by service.name=sophie/server: HTTP traffic and latency, PostgreSQL, Node.js runtime, container resources, and library activity. — Mackerel dashboardをもとに、Prometheus/Lokiの実データへ適応。",
  "uid": "materia-sophie",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "sophie"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/sophie",
      "targetBlank": true
    },
    {
      "type": "dashboards",
      "title": "Related dashboards",
      "tags": [
        "mackerel-migration"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "stat",
      "description": "HTTP Requests。選択期間の実測値。イベント指標はイベント発生前に系列が存在しない場合があります。",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(irate(http_server_request_duration_seconds_count{job=\"sophie/server\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "wideLayout": true
      },
