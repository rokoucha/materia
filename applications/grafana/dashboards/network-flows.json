    {
      "id": 3,
      "title": "TRAFFIC PATHS · Device → AS → service port",
      "type": "netsage-sankey-panel",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 15
      },
      "description": "線の太さは選択期間の推定転送量。各列の上位N件以外はOtherに集約し総量を保ちます。HTTPS等は標準ポート名の補助表示で、アプリ識別ではありません。",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "monochrome": false,
        "nodeWidth": 12,
        "nodePadding": 16,
        "iteration": 32,
        "valueField": "Bytes",
        "labelSize": 12,
        "textColor": "#D8D9DA",
        "nodeColor": "#5794F2"
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "network-flows"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "network-flows"
          },
          "rawSql": "WITH selected AS (\n  SELECT device_mac AS device, remote_as,\n         CASE\n  WHEN ip_proto=6 AND service_port=443 THEN 'HTTPS · TCP/443'\n  WHEN ip_proto=17 AND service_port=443 THEN 'QUIC · UDP/443'\n  WHEN ip_proto IN (6,17) AND service_port=53 THEN CASE WHEN ip_proto=6 THEN 'DNS · TCP/53' ELSE 'DNS · UDP/53' END\n  WHEN ip_proto=6 AND service_port=853 THEN 'DoT · TCP/853'\n  WHEN ip_proto=17 AND service_port=853 THEN 'DoQ · UDP/853'\n  WHEN ip_proto=6 AND service_port=80 THEN 'HTTP · TCP/80'\n  WHEN ip_proto=6 AND service_port=22 THEN 'SSH · TCP/22'\n  WHEN ip_proto=1 THEN 'ICMP'\n  WHEN ip_proto=58 THEN 'ICMPv6'\n  WHEN ip_proto IN (6,17) THEN CASE WHEN ip_proto=6 THEN 'TCP/' ELSE 'UDP/' END || service_port::text\n  ELSE 'IP/' || ip_proto::text END AS service, bytes\n  FROM traffic\n  WHERE $__timeFilter(time) AND direction = ${direction:sqlstring} AND (${device:sqlstring} = 'all' OR device_mac::text = ${device:sqlstring})\n), devices AS (\n  SELECT device FROM selected GROUP BY device ORDER BY sum(bytes) DESC LIMIT LEAST(50, GREATEST(1, ${top:sqlstring}::int))\n), ases AS (\n  SELECT remote_as FROM selected GROUP BY remote_as ORDER BY sum(bytes) DESC LIMIT LEAST(50, GREATEST(1, ${top:sqlstring}::int))\n), services AS (\n  SELECT service FROM selected GROUP BY service ORDER BY sum(bytes) DESC LIMIT LEAST(50, GREATEST(1, ${top:sqlstring}::int))\n)\nSELECT CASE WHEN device IN (SELECT device FROM devices) THEN COALESCE(d.label, device::text) ELSE 'Other devices' END AS \"Device\",\n       CASE WHEN remote_as IN (SELECT remote_as FROM ases) THEN COALESCE(a.name, 'AS' || remote_as::text) ELSE 'Other ASes' END AS \"AS\",\n       CASE WHEN service IN (SELECT service FROM services) THEN service ELSE 'Other services' END AS \"Service\",\n       sum(bytes)::double precision AS \"Bytes\"\nFROM selected LEFT JOIN device_labels d ON d.mac=selected.device\nLEFT JOIN as_names a ON a.asn=selected.remote_as\nGROUP BY 1,2,3 ORDER BY 4 DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ]
    },
