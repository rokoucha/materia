          "rawSql": "SELECT COALESCE(d.label,t.device_mac::text) AS \"Device\",sum(bytes)::double precision AS \"Bytes\" FROM traffic t LEFT JOIN device_labels d ON d.mac=t.device_mac WHERE $__timeFilter(time) AND direction = ${direction:sqlstring} AND (${device:sqlstring} = 'all' OR device_mac::text = ${device:sqlstring}) GROUP BY t.device_mac,d.label ORDER BY 2 DESC LIMIT 10",
