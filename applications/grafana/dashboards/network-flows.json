        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "network-flows"
          },
          "rawSql": "WITH selected AS (\n SELECT time, COALESCE(a.name,'AS'||remote_as::text) AS name,bytes\n FROM traffic LEFT JOIN as_names a ON a.asn=remote_as WHERE $__timeFilter(time) AND direction = ${direction:sqlstring} AND (${device:sqlstring} = 'all' OR device_mac::text = ${device:sqlstring})\n), top_ases AS (\n SELECT name FROM selected GROUP BY name ORDER BY sum(bytes) DESC LIMIT 8\n)\nSELECT $__timeGroupAlias(time,'5m',0), CASE WHEN name IN (SELECT name FROM top_ases) THEN name ELSE 'Other ASes' END AS metric,\n       sum(bytes)::double precision * 8 / 300 AS value\nFROM selected GROUP BY 1,2 ORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ]
    },
