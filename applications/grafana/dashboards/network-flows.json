      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "network-flows"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "network-flows"
          },
          "rawSql": "WITH selected AS (\n SELECT CASE\n  WHEN ip_proto=6 AND service_port=443 THEN 'HTTPS · TCP/443'\n  WHEN ip_proto=17 AND service_port=443 THEN 'QUIC · UDP/443'\n  WHEN ip_proto IN (6,17) AND service_port=53 THEN CASE WHEN ip_proto=6 THEN 'DNS · TCP/53' ELSE 'DNS · UDP/53' END\n  WHEN ip_proto=6 AND service_port=853 THEN 'DoT · TCP/853'\n  WHEN ip_proto=17 AND service_port=853 THEN 'DoQ · UDP/853'\n  WHEN ip_proto=6 AND service_port=80 THEN 'HTTP · TCP/80'\n  WHEN ip_proto=6 AND service_port=22 THEN 'SSH · TCP/22'\n  WHEN ip_proto=1 THEN 'ICMP'\n  WHEN ip_proto=58 THEN 'ICMPv6'\n  WHEN ip_proto IN (6,17) THEN CASE WHEN ip_proto=6 THEN 'TCP/' ELSE 'UDP/' END || service_port::text\n  ELSE 'IP/' || ip_proto::text END AS service, bytes FROM traffic WHERE $__timeFilter(time) AND direction = ${direction:sqlstring} AND (${device:sqlstring} = 'all' OR device_mac::text = ${device:sqlstring})\n), ranked AS (\n SELECT service,sum(bytes)::double precision AS bytes,row_number() OVER (ORDER BY sum(bytes) DESC) AS rank\n FROM selected GROUP BY service\n)\nSELECT CASE WHEN rank<=6 THEN service ELSE 'Other ports' END AS \"Port\", sum(bytes)::double precision AS \"Bytes\"\nFROM ranked GROUP BY 1 ORDER BY 2 DESC\n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ]
