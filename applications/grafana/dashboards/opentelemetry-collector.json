{
  "title": "OpenTelemetry Collector",
  "description": "OpenTelemetry Collector — Mackerel dashboardをもとに、Prometheus/Lokiの実データへ適応。",
  "uid": "materia-opentelemetry-collector",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "opentelemetry-collector"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/5jZSsdErBrA",
      "targetBlank": true
    },
    {
      "type": "dashboards",
      "title": "Related dashboards",
      "tags": [
        "mackerel-migration"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "Receiver",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "<br>"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "id": 1
    },
    {
      "title": "Accepted Spans Rate",
      "type": "timeseries",
      "description": "Accepted Spans Rate。選択期間の実測値。イベント指標はイベント発生前に系列が存在しない場合があります。",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(irate(otelcol_receiver_accepted_spans_total{job=~\".*/otelcol\"}[$__rate_interval])) by (receiver)",
          "legendFormat": "{{receiver}}",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
