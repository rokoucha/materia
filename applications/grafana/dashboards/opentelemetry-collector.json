    {
      "title": "Exporter Failures /s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "description": "Exporter Failures /s。選択した範囲の実測値。未発生イベントの系列は存在しない場合があります。",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(otelcol_exporter_enqueue_failed_spans_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_exporter_enqueue_failed_metric_points_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_exporter_enqueue_failed_log_records_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_exporter_send_failed_spans_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_exporter_send_failed_metric_points_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_exporter_send_failed_log_records_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"})))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
