{
  "title": "OpenTelemetry Collector",
  "description": "Collector選択、受信・処理・送信、バッチ分布、キューとランタイムを統合。旧ダッシュボードの動的suffix判定を実際のメトリクス名に置き換える。",
  "uid": "materia-opentelemetry-collector",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "opentelemetry-collector"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "collector",
        "label": "Collector",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bdy6m43uy9ybkd"
        },
        "query": {
          "query": "label_values(otelcol_process_cpu_seconds_total, job)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(otelcol_process_cpu_seconds_total, job)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/5jZSsdErBrA",
      "targetBlank": true
    },
    {
      "type": "dashboards",
      "title": "Related dashboards",
      "tags": [
        "mackerel-migration"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "Collector Instances",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "description": "Collector Instances。選択した範囲の実測値。未発生イベントの系列は存在しない場合があります。",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "count(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "id": 1
    },
    {
      "title": "Receiver Refusals /s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "description": "Receiver Refusals /s。選択した範囲の実測値。未発生イベントの系列は存在しない場合があります。",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(otelcol_receiver_refused_spans_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_receiver_refused_metric_points_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"}))) + (sum(rate(otelcol_receiver_refused_log_records_total{job=~\"${collector:regex}\"}[$__rate_interval])) or (0 * sum(otelcol_process_cpu_seconds_total{job=~\"${collector:regex}\"})))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "id": 2
