    {
      "title": "Battery Time Left",
      "type": "stat",
      "description": "Battery Time Left。選択期間の実測値。イベント指標はイベント発生前に系列が存在しない場合があります。",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(apcupsd_battery_time_left_seconds{job=\"apcupsd/apcupsd-exporter\",ups=\"BR550S\"}/60)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
