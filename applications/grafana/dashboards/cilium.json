{
  "title": "Cilium",
  "description": "materia-cluster の Cilium を俯瞰する運用ダッシュボード。エンドポイント、到達性、パケット処理、ドロップ、BPF map、ポリシー、コントローラ、リソース使用量を監視。 — Mackerel dashboardをもとに、Prometheus/Lokiの実データへ適応。",
  "uid": "materia-cilium",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "cilium"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/cilium",
      "targetBlank": true
    },
    {
      "type": "dashboards",
      "title": "Related dashboards",
      "tags": [
        "mackerel-migration"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
