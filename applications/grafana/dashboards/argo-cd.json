{
  "title": "Argo CD",
  "description": "materia-cluster の Argo CD を俯瞰する運用ダッシュボード。同期・ヘルス状態、reconcile、sync、Kubernetes API、Git、Redis、通知、クラスタ接続を監視。 — Mackerel dashboardをもとに、Prometheus/Lokiの実データへ適応。",
  "uid": "materia-argo-cd",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "argo-cd"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/argocd",
      "targetBlank": true
    },
    {
      "type": "dashboards",
      "title": "Related dashboards",
      "tags": [
        "mackerel-migration"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
