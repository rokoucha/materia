{
  "title": "Authentik",
  "description": "materia-cluster の authentik を俯瞰する運用ダッシュボード。HTTP、Outpost、バックグラウンドタスク、PostgreSQL、プロセスリソースを監視。 — Mackerel dashboardをもとに、Prometheus/Lokiの実データへ適応。",
  "uid": "materia-authentik",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "authentik"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/authentik",
      "targetBlank": true
    },
    {
      "type": "dashboards",
      "title": "Related dashboards",
      "tags": [
        "mackerel-migration"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "Connected Outposts",
      "type": "stat",
      "description": "Connected Outposts。選択期間の実測値。イベント指標はイベント発生前に系列が存在しない場合があります。",
      "datasource": {
        "type": "prometheus",
        "uid": "bdy6m43uy9ybkd"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(authentik_outposts_connected{job=\"authentik/authentik\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "id": 1,
      "interval": "1m"
