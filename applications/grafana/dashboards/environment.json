{
  "title": "Environment",
  "description": "SwitchBotの機器別温湿度・電池とEnvcolの温度・湿度・気圧・CO₂を一つにまとめた環境ダッシュボード。",
  "uid": "materia-environment",
  "schemaVersion": 39,
  "timezone": "browser",
  "editable": false,
  "tags": [
    "materia",
    "mackerel-migration",
    "environment"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "SwitchBot device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bdy6m43uy9ybkd"
        },
        "query": {
          "query": "label_values(switchbot_meter_temperature, deviceName)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(switchbot_meter_temperature, deviceName)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "Mackerel original",
      "url": "https://mackerel.io/orgs/rokoucha/dashboards/5ghSA4eVNxb",
