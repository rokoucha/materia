[Unit]
Description=Wi-SUN B-route MQTT exporter
Wants=network-online.target mosquitto.service
After=network-online.target mosquitto.service
ConditionPathExists=/etc/route-b-exporter/environment

[Service]
User=route-b-exporter
SupplementaryGroups=uucp
EnvironmentFile=/etc/route-b-exporter/environment
ExecStart=/usr/local/bin/akizuki-dg-route-b-exporter /dev/ttyS1
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
DevicePolicy=closed
DeviceAllow=/dev/ttyS1 rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
